# 复制为 .env 供本地开发使用；以下均为本机占位值，禁止提交真实密钥（docs/repository-maintenance §4）
DB_URL=jdbc:postgresql://localhost:5432/flexforge
DB_USERNAME=flexforge
DB_PASSWORD=flexforge

# JWT 签名密钥（S4：仅环境变量注入，>=256bit；生成示例：openssl rand -base64 48）
AUTH_JWT_SECRET=

# JWT 有效期（ISO-8601；默认 8h。演示环境应覆盖完整演示时长，docs/09 P03）
AUTH_JWT_TTL=PT8H

# 首次启动引导管理员（仅在 sys_user 为空时生效；不设置则不引导；S4：真实密码不进仓库）
FLEXFORGE_BOOTSTRAP_ADMIN_PASSWORD=

# Compose 宿主端口（避免与本机其他服务冲突）
BACKEND_PORT=8088
FRONTEND_PORT=5173

# 在线模型（P11，可选；未配置 provider 时默认 fixture，docs/09 P11）
# FLEXFORGE_AI_PROVIDER=http 时启用 OpenAI 兼容路径；P15 起设置页（ADMIN）为第二条
# 受控通道：base-url/model/API Key 持久化，密钥 AES-GCM 加密落库、读接口只回掩码（docs/13 §3.6-5）。
# 本处环境变量仍是缺省通道，且密钥绝不以明文入库。
FLEXFORGE_AI_PROVIDER=fixture
FLEXFORGE_AI_BASE_URL=
FLEXFORGE_AI_API_KEY=

# 自助注册开关（P13，默认开；关闭时登录页隐藏注册入口，docs/13 §3.1-5）
# 部署顺序约定：先设置引导管理员密码完成首启，再开放注册（防空库窗口抢注）
FLEXFORGE_SELF_REGISTRATION=true

# 端到端演示脚本（scripts/demo-e2e.sh，P12）：演示账号口令（不存在时由管理员经 API 创建）
# FLEXFORGE_ADMIN_PASS 必须与上方 FLEXFORGE_BOOTSTRAP_ADMIN_PASSWORD 同值（同一管理员凭据）
FLEXFORGE_ADMIN_USER=admin
FLEXFORGE_ADMIN_PASS=
FLEXFORGE_DEMO_DEV_USER=demo-developer
FLEXFORGE_DEMO_DEV_PASS=
FLEXFORGE_DEMO_USER=demo-user
FLEXFORGE_DEMO_PASS=
